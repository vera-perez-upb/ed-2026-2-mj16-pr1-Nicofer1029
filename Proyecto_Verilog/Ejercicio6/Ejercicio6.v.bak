module Ejercicio6(iA,iB,iC,oW,oX,oY,oZ); 
input iA,iB,iC; 
output oAND,oOR,oNOT,oXOR; 

//Compuerta AND 3-In 
assign oAND = ((iA==1'b1) && (iB==1'b1) && (iC==1'b1)) ? 1'b1 : 1'b0;	

//Compuerta OR 3-In 
assign oOR = ((iA==1'b0) && (iB==1'b0) && (iC==1'b0)) ? 1'b0 : 1'b1;

//Compuerta NOT		 
assign oNOT = (iA == 1'b0) ? 1'b1 : 1'b0; 

//Compuerta XOR 2-In 
assign oXOR = ((iA==1'b0) && (iB==1'b1)) ? 1'b1 : (((iA==1'b1) && 	(iB==1'b0)) ? 1'b1: 1'b0); 

endmodule 